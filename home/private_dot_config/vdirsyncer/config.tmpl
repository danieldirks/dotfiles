[general]
status_path = "~/.local/state/vdirsyncer/status/"

[pair calendars]
a = "calendars_remote"
b = "calendars_local"
collections = ["from a", "from b"]
metadata = ["displayname", "color"]

[storage calendars_remote]
type = "caldav"
url = {{ .caldav_url | quote }}
username = {{ .chezmoi.username | quote }}
# password from secret service (keepassxc entry needs attribute: service = vdirsyncer)
password.fetch = ["command", "secret-tool", "lookup", "service", "vdirsyncer"]

[storage calendars_local]
type = "filesystem"
path = "~/.local/share/calendars/"
fileext = ".ics"

[pair contacts]
a = "contacts_remote"
b = "contacts_local"
collections = ["from a", "from b"]

[storage contacts_remote]
type = "carddav"
url = {{ .caldav_url | quote }}
username = {{ .chezmoi.username | quote }}
# password from secret service (keepassxc entry needs attribute: service = vdirsyncer)
password.fetch = ["command", "secret-tool", "lookup", "service", "vdirsyncer"]

[storage contacts_local]
type = "filesystem"
path = "~/.local/share/contacts/"
fileext = ".vcf"
