#!/bin/bash
# vim: ft=bash

HI='\033[33m'
CL='\033[0m'

set -e


{{ if eq .osid "linux-arch" -}}
############
### arch ###
############

echo -e "\n${HI}pacman autoremove${CL}"
sudo pacman -Rns $(pacman -Qtdq)

{{- end }}

echo -e "\n${HI}flatpak uninstall --unused${CL}"
flatpak uninstall --unused

###################
### clear cache ###
###################

echo -e "\n${HI}remove cache${CL}"
rm -rf ~/.cache/
echo -e "\n${HI}reset nvim${CL}"
rm -rf ~/.local/share/nvim/
